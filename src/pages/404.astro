---
import Layout from '~/layouts/Layout.astro'
---

<Layout title="404 | Aldo R. Robles">
  <h1 class="text-xl">Not found</h1>
  <p class="text-fg-muted mt-6">
    Sorry, but the page you're looking for isn't available. It might have been
    moved, deleted, or never existed.
  </p>

  <div class="mt-8">
    <a
      href="/"
      class="text-fg-muted hover:text-fg focus:ring-accent underline transition duration-300 focus:ring-2"
      >Back to home</a
    >
  </div>
</Layout>
