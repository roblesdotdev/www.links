---
import Layout from '../layouts/Layout.astro'
import links from '~/data/links.json'
import AppLink from '~/components/AppLink.astro'
---

<Layout title="Aldo R. Robles Links">
  <div class="grid place-items-center gap-12 sm:gap-16">
    <div class="grid max-w-md place-items-center text-center">
      <img
        src="/profile.webp"
        alt="Aldo R. Robles avatar"
        class="animate-slide-up ring-panel ring-offset-canvas size-20 rounded-full ring-2 ring-offset-4"
      />
      <h1
        class="animate-slide-up xs:text-2xl mt-6 text-lg font-medium whitespace-nowrap [animation-delay:150ms]"
      >
        Aldo R. Robles
      </h1>
      <p
        class="animate-slide-up xs:leading-7 text-fg-muted mt-4 text-sm [animation-delay:300ms] sm:text-base"
      >
        👋 Hey there! Here you can find links to my work, personal projects, and
        more.
      </p>
    </div>

    <ul class="flex w-full flex-col gap-2">
      {links.map((link, idx) => <AppLink idx={idx} link={link} />)}
    </ul>
  </div>
</Layout>
